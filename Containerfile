      io.daemonless.upstream-mode=pkg \
      io.daemonless.category="Infrastructure" \
      io.daemonless.port="17170" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.packages="${PACKAGES}"
      

# Update to latest patch level
RUN pkg update -r FreeBSD-base && \
    pkg upgrade -y -r FreeBSD-base && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Install lldap from FreeBSD packages (pkg handles all dependencies)
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Create version info
RUN LLDAP_VERSION=$(pkg info "${PKG_NAME}" | sed -n 's/.*Version.*: *//p') && \
    mkdir -m 0755 -p /app && echo "$LLDAP_VERSION" > /app/version


RUN cp -r /usr/local/lldap_server/lldap /usr/local/lldap_server/app \
          /usr/local/bin/lldap_migration_tool /usr/local/bin/lldap_set_password \
          /app

# Copy root filesystem
COPY root/ /

# Set permissions
RUN chmod +x /etc/services.d/lldap/run /etc/cont-init.d/* /healthz

