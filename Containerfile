ARG BASE_VERSION=15
FROM ghcr.io/daemonless/base:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME="lldap"
ARG PACKAGES="zstd ${PKG_NAME}"
ARG APP_VERSION="latest"
#ARG DOWNLOAD_URL="https://example.com/lldap-${APP_VERSION}.tar.gz"

ENV LLDAP_CONFIG_FILE="/config/lldap_config.toml"

LABEL org.opencontainers.image.title="lldap" \
      org.opencontainers.image.description="This project is a lightweight authentication server that provides an opinionated, simplified LDAP interface for authentication." \
      org.opencontainers.image.source="https://github.com/daemonless/lldap" \
      org.opencontainers.image.url="https://github.com/lldap/lldap" \
